{
  "name": "echo",
  "version": "1.0.0",
  "description": "Echo - A personal text transfer assistant built on Cloudflare Workers + D1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:frontend": "node build.js",
    "build": "npm run build:frontend",
    "dev": "npm run build:frontend && wrangler dev",
    "deploy": "bash scripts/deploy.sh",
    "prepare-wrangler": "node scripts/prepare-wrangler.js",
    "db:init": "wrangler d1 execute echo-db --file=./schema.sql",
    "db:init:local": "wrangler d1 execute echo-db --local --file=./schema.sql"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-php": "^6.0.1",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.3",
    "@codemirror/legacy-modes": "^6.4.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@uiw/codemirror-theme-github": "^4.23.6",
    "codemirror": "^6.0.1",
    "dompurify": "^3.2.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11",
    "marked": "^14.1.4",
    "marked-katex-extension": "^5.1.1",
    "marked-mangle": "^1.1.9",
    "marked-smartypants": "^1.1.9",
    "mermaid": "^11.4.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "esbuild": "^0.24.2",
    "wrangler": "^3.95.0"
  }
}
